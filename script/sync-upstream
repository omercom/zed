#!/usr/bin/env bash
set -e

# Repository kök dizinine git
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

BRANCH="omer"
UPSTREAM_REMOTE="upstream"
FORK_REMOTE="origin"

echo "=================================================="
echo "🔄 Zed Upstream Güncelleme ve Senkronizasyon Aracı"
echo "=================================================="

# 1. Upstream'den son referansları çek
echo "📥 Resmi Zed (upstream) güncellemeleri kontrol ediliyor..."
git fetch "$UPSTREAM_REMOTE"

LOCAL_MAIN=$(git rev-parse main)
REMOTE_MAIN=$(git rev-parse "$UPSTREAM_REMOTE/main")
BEHIND_COMMITS=$(git rev-list --count "$BRANCH..$UPSTREAM_REMOTE/main")

# 2. Fark kontrolü: Yeni commit var mı?
if [[ "$LOCAL_MAIN" == "$REMOTE_MAIN" && "$BEHIND_COMMITS" -eq 0 ]]; then
    echo "✨ Resmi repoda yeni bir değişiklik yok! Projeniz zaten en güncel sürümde."
    echo "=================================================="
    exit 0
fi

echo "📦 Resmi repoda $BEHIND_COMMITS adet yeni commit tespit edildi!"
echo "Son gelen bazı güncellemeler:"
git log --oneline -n 5 "$UPSTREAM_REMOTE/main" "^$LOCAL_MAIN" 2>/dev/null || true
echo "--------------------------------------------------"

# 3. Değişiklik kontrolü (çalışma ağacı temiz mi?)
STASHED=0
if ! git diff-index --quiet HEAD -- 2>/dev/null; then
    echo "⚠️  Kaydedilmemiş değişiklikler var, geçici stash'e alınıyor..."
    git stash push -m "auto-sync-stash-$(date +%s)"
    STASHED=1
fi

# 4. main branch'ini upstream ile senkronize et
echo "🔀 1/4: Yerel 'main' branch'i güncelleniyor..."
git checkout main
git merge --ff-only "$UPSTREAM_REMOTE/main"

# 5. Kendi fork'undaki (origin) main'i de güncelle
echo "🚀 2/4: Fork'undaki 'main' branch'i güncelleniyor..."
git push "$FORK_REMOTE" main

# 6. Kendi çalışma branch'ine geç ve rebase yap
echo "🌿 3/4: '$BRANCH' branch'ine geçilip güncel kodların üzerine taşınıyor (rebase)..."
git checkout "$BRANCH"

if git rebase main; then
    echo "✅ Rebase başarılı!"
else
    echo "❌ Rebase sırasında çakışma (conflict) oluştu!"
    echo "Lütfen çakışan dosyaları düzeltip 'git rebase --continue' yapın."
    exit 1
fi

# 7. Güncellenen çalışma branch'ini fork'a push et
echo "📤 4/4: Güncellenen '$BRANCH' branch'i fork'a push ediliyor..."
git push --force-with-lease "$FORK_REMOTE" "$BRANCH"

# Eğer stash yapıldıysa geri yükle
if [[ $STASHED -eq 1 ]]; then
    echo "📦 Geçici stash değişiklikleri geri yükleniyor..."
    git stash pop
fi

echo ""
echo "=================================================="
echo "🎉 Güncelleme başarıyla tamamlandı!"
echo "   - $BEHIND_COMMITS yeni güncelleme '$BRANCH' branch'inize entegre edildi."
echo "   - Fork'unuz güncellendi."
echo "=================================================="
